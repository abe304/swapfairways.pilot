# Copia este archivo a .env.local y llena los valores de tu proyecto Supabase
# (Project Settings > API en el dashboard de Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key: NUNCA la expongas al cliente ni la subas a git.
# Se usa en scripts/seed.ts, y también en el servidor (app/ofertas/actions.ts)
# para buscar el email del anfitrión al notificarle una nueva solicitud.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Opcional — notificación por email al anfitrión cuando recibe una
# solicitud. Sin esto configurado, la app funciona igual, solo no envía
# el correo. Crea una cuenta gratis en https://resend.com y genera un API key.
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado en Resend, puedes dejar el de
# pruebas de Resend (funciona sin configuración extra):
RESEND_FROM_EMAIL="SwapFairways <onboarding@resend.dev>"

# Dominio público (sin "/" final). Se usa para armar los enlaces de invitación.
# Si no se define, se usa la dirección del request (p. ej. *.vercel.app).
NEXT_PUBLIC_SITE_URL=…
# Correo de contacto que se muestra en la home y en el registro (opcional).
NEXT_PUBLIC_CONTACT_EMAIL=…
